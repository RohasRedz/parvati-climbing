## 🎵 **Audio System Integration**

### **Equipment Sound Library**
**File**: `utils/soundManager.js`

```javascript
class ClimbingSoundManager {
  constructor() {
    this.sounds = {
      carabinerClick: '/sounds/carabiner-click.mp3',
      ropeSwish: '/sounds/rope-movement.mp3', 
      chalkPuff: '/sounds/chalk-bag.mp3',
      metalClink: '/sounds/metal-clink.mp3',
      windAmbient: '/sounds/mountain-wind.mp3',
      successBell: '/sounds/summit-bell.mp3'
    };
    
    this.audioContext = null;
    this.loadedSounds = new Map();
    this.enabled = true;
  }

  async initAudio() {
    if (!this.audioContext) {
      this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
    }
    
    // Load all sound files
    for (const [key, url] of Object.entries(this.sounds)) {
      try {
        const buffer = await this.loadSound(url);
        this.loadedSounds.set(key, buffer);
      } catch (error) {
        console.warn(`Failed to load sound: ${key}`, error);
      }
    }
  }

  async loadSound(url) {
    const response = await fetch(url);
    const arrayBuffer = await response.arrayBuffer();
    return await this.audioContext.decodeAudioData(arrayBuffer);
  }

  playSound(soundKey, volume = 0.5) {
    if (!this.enabled || !this.audioContext || !this.loadedSounds.has(soundKey)) {
      return;
    }

    const source = this.audioContext.createBufferSource();
    const gainNode = this.audioContext.createGain();
    
    source.buffer = this.loadedSounds.get(soundKey);
    gainNode.gain.value = volume;
    
    source.connect(gainNode);
    gainNode.connect(this.audioContext.destination);
    source.start();
  }

  // Climbing-specific sound methods
  carabinerClick() { this.playSound('carabinerClick', 0.3); }
  ropeMovement() { this.playSound('ropeSwish', 0.2); }
  chalkApplication() { this.playSound('chalkPuff', 0.4); }
  equipmentClink() { this.playSound('metalClink', 0.3); }
  summitSuccess() { this.playSound('successBell', 0.6); }
}

export default new ClimbingSoundManager();
```

