### **2. Custom Climbing Loader**
**File**: `components/animations/ClimbingLoader.js`

```javascript
import { useEffect, useRef, useState } from 'react';
import { gsap } from 'gsap';
import anime from 'animejs';

export default function ClimbingLoader({ 
  isLoading = true, 
  progress = 0, 
  loadingMessages = [
    "Checking equipment...",
    "Planning route...", 
    "Testing holds...",
    "Starting ascent...",
    "Almost there..."
  ]
}) {
  const loaderRef = useRef(null);
  const climberRef = useRef(null);
  const ropeRef = useRef(null);
  const [currentMessage, setCurrentMessage] = useState(0);

  useEffect(() => {
    if (!isLoading) return;

    // Animate climber ascending the progress rope
    const animateClimberProgress = () => {
      const climber = climberRef.current;
      const rope = ropeRef.current;
      
      if (!climber || !rope) return;

      gsap.to(climber, {
        yPercent: -(progress * 100),
        duration: 0.5,
        ease: 'power2.out',
        onUpdate: function() {
          // Add climbing motion simulation
          const currentY = this.progress();
          gsap.set(climber, {
            rotation: Math.sin(currentY * Math.PI * 4) * 3,
            x: Math.sin(currentY * Math.PI * 8) * 2
          });
        }
      });

      // Update rope tension visualization
      gsap.to(rope, {
        scaleY: 1 + (progress * 0.1),
        duration: 0.3,
        ease: 'power2.out'
      });
    };

    // Cycle through loading messages
    const messageInterval = setInterval(() => {
      setCurrentMessage(prev => (prev + 1) % loadingMessages.length);
    }, 1500);

    // Rope coiling animation while waiting
    anime({
      targets: '.rope-coil',
      rotate: '1turn',
      duration: 2000,
      easing: 'linear',
      loop: true
    });

    // Carabiner spinning with metallic shine effect
    anime({
      targets: '.loader-carabiner',
      rotate: '360deg',
      duration: 3000,
      easing: 'easeInOutQuad',
      loop: true,
      direction: 'alternate'
    });

    animateClimberProgress();

    return () => {
      clearInterval(messageInterval);
    };

  }, [isLoading, progress, loadingMessages]);

  if (!isLoading) return null;

  return (
    <div ref={loaderRef} className="climbing-loader-overlay">
      <div className="loader-content">
        
        {/* Main climbing progress visualization */}
        <div className="climbing-progress">
          <div ref={ropeRef} className="progress-rope">
            <div className="rope-texture"></div>
          </div>
          
          <div ref={climberRef} className="climber-avatar">
            <svg viewBox="0 0 50 50" className="climber-svg">
              {/* Simplified climber silhouette */}
              <circle cx="25" cy="10" r="5" fill="#333" />
              <rect x="20" y="15" width="10" height="20" rx="3" fill="#333" />
              <rect x="15" y="25" width="8" height="15" rx="2" fill="#333" />
              <rect x="27" y="25" width="8" height="15" rx="2" fill="#333" />
            </svg>
          </div>
        </div>

        {/* Equipment status display */}
        <div className="equipment-status">
          <div className="loader-carabiner">🧗</div>
          <div className="rope-coil">🔗</div>
          <div className="chalk-bag">🎒</div>
        </div>

        {/* Loading message and progress */}
        <div className="loading-info">
          <p className="loading-message">
            {loadingMessages[currentMessage]}
          </p>
          <div className="progress-bar">
            <div 
              className="progress-fill"
              style={{ width: `${progress}%` }}
            />
          </div>
          <span className="progress-text">{Math.round(progress)}%</span>
        </div>

        {/* Mountain silhouette background */}
        <div className="mountain-silhouette">
          <svg viewBox="0 0 400 200" className="mountain-svg">
            <path d="M0 200 L50 150 L100 120 L150 140 L200 100 L250 130 L300 110 L350 140 L400 120 L400 200 Z" 
                  fill="#1a1a1a" opacity="0.3" />
          </svg>
        </div>
      </div>
    </div>
  );
}
