### **3. Navigation Rope System**
**File**: `components/enhanced/Nav.js`

```javascript
import { useRouter } from 'next/router';
import { useEffect, useRef } from 'react';
import Link from 'next/link';
import { gsap } from 'gsap';
import siteConfig from '../../lib/mock/site';
import useRouteTransition from '../../hooks/useRouteTransition';

export default function EnhancedNav() {
  const router = useRouter();
  const navRef = useRef(null);
  const ropeRef = useRef(null);
  const carabinersRef = useRef([]);
  const { triggerRouteTransition } = useRouteTransition();

  useEffect(() => {
    // Initialize rope navigation system
    const initRopeNav = () => {
      const rope = ropeRef.current;
      const carabiners = carabinersRef.current;

      if (!rope || !carabiners.length) return;

      // Rope entrance animation
      gsap.fromTo(rope, {
        scaleX: 0,
        transformOrigin: 'left center'
      }, {
        scaleX: 1,
        duration: 1.5,
        ease: 'power2.out'
      });

      // Carabiner clip-in sequence
      carabiners.forEach((carabiner, index) => {
        gsap.fromTo(carabiner, {
          y: -50,
          rotation: -45,
          scale: 0.8
        }, {
          y: 0,
          rotation: 0,
          scale: 1,
          duration: 0.8,
          delay: 0.2 + (index * 0.1),
          ease: 'bounce.out',
          onComplete: () => {
            // Add subtle breathing animation
            gsap.to(carabiner, {
              scale: 1.05,
              duration: 2,
              ease: 'sine.inOut',
              repeat: -1,
              yoyo: true
            });
          }
        });
      });
    };

    initRopeNav();
  }, []);

  const handleNavClick = async (e, href) => {
    e.preventDefault();
    await triggerRouteTransition(href);
    router.push(href);
  };

  return (
    <nav ref={navRef} className="enhanced-nav">
      {/* Rope background element */}
      <div ref={ropeRef} className="nav-rope">
        <div className="rope-texture"></div>
        <div className="rope-fibers"></div>
      </div>

      <div className="nav-content">
        {/* Logo/Brand as anchor point */}
        <Link href="/" className="nav-anchor">
          <div className="anchor-point">
            <span className="brand-text">{siteConfig.title}</span>
            <div className="anchor-icon">⚓</div>
          </div>
        </Link>

        {/* Navigation items as carabiners */}
        <div className="nav-carabiners">
          {siteConfig.navItems.map((item, index) => (
            <div
              key={item.path}
              ref={el => carabinersRef.current[index] = el}
              className={`nav-carabiner ${router.pathname === item.path ? 'active' : ''}`}
            >
              <Link 
                href={item.path}
                onClick={(e) => handleNavClick(e, item.path)}
                className="carabiner-link"
              >
                <div className="carabiner-body">
                  <svg viewBox="0 0 100 200" className="carabiner-svg">
                    <path className="carabiner-outline" 
                          d="M20 20 C20 10 30 10 40 20 L40 180 C40 190 30 190 20 180 Z" />
                    <path className="carabiner-gate" 
                          d="M40 20 L70 25 L70 175 L40 180" />
                  </svg>
                  <span className="nav-label">{item.label}</span>
                </div>
                
                {/* Active route indicator */}
                {router.pathname === item.path && (
                  <div className="route-indicator">
                    <div className="climbing-light"></div>
                  </div>
                )}
              </Link>
            </div>
          ))}
        </div>

        {/* Emergency contact (mobile menu trigger) */}
        <button className="emergency-contact mobile-menu-trigger">
          <span className="whistle-icon">📯</span>
        </button>
      </div>
    </nav>
  );
}
```

